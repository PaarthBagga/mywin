# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Shared secret for the API. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MYWIN_TOKEN=

# Postgres connection string. This one matches docker-compose.yml.
# In production, use your Neon connection string instead.
DATABASE_URL=postgres://mywin:mywin@localhost:5432/mywin

# Optional, used from Phase 2. Without a key the app uses offline fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=
